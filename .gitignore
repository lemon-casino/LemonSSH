# =============================================================================
# Allowlist .gitignore (https://github.com/binaricat/Netcatty/issues/2534)
#
# Layer 1 - default-deny at the repository root
# Layer 2 - re-include only paths that belong in git
# Layer 3 - classical denylist for generated / local / secret artifacts
#
# Goal: a mistaken `git add .` (or an agent doing the same) cannot pick up
# random root files, agent state dirs, env files, or build outputs.
# =============================================================================

# --- Layer 1: ignore everything at the repository root by default ---
/*

# --- Layer 2: allowlist root files ---
!.gitattributes
!.gitignore
!.npmrc
!AGENTS.md
!App.tsx
!CHANGELOG.md
!CLAUDE.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!LICENSE
!PRIVACY.md
!README.ja-JP.md
!README.md
!README.zh-CN.md
!README.zh-TW.md
!eslint.config.js
!global.d.ts
!index.css
!index.html
!index.tsx
!metadata.json
!package-lock.json
!package.json
!tsconfig.json
!types.ts
!vite.config.ts
# Root regression tests must not be silently excluded by the allowlist.
!/*.test.ts
!/*.test.tsx

# --- Layer 2: allowlist root directories ---
# Un-ignore the directory entry, then everything under it. Git does not
# traverse ignored directories, so both steps are required.
!.github/
!.github/**
!.vscode/
!.vscode/**
!application/
!application/**
!build/
!build/**
!components/
!components/**
!docs/
!docs/**
!domain/
!domain/**
!examples/
!examples/**
!go.mod
!go.sum
!cmd/
/cmd/netcatty/frontend/dist/*
!/cmd/netcatty/frontend/dist/index.html
/cmd/netcatty/bin
/cmd/netcatty-profile-broker/*.exe
!cmd/**
/cmd/netcatty/frontend/.retired-dist-*
/cmd/netcatty/frontend/dist.retired-*
/cmd/netcatty/frontend/dist.vacate-*
!internal/
!internal/**
!tools/
!tools/**
!infrastructure/
!infrastructure/**
!lib/
!lib/**
!packages/
!packages/**
!patches/
!patches/**
!public/
!public/**
!resources/
!resources/**
!scripts/
!scripts/**
!skills/
!skills/**
!types/
!types/**

# Keep committed contract and provider fixtures; ignore other test data.
!/testdata/
/testdata/*
!/testdata/migration/
/testdata/migration/*
!/testdata/migration/contracts/
!/testdata/migration/contracts/**
!/testdata/ai/
/testdata/ai/*
!/testdata/ai/provider/
!/testdata/ai/provider/**

# --- Layer 3: classical denylist (applies inside allowlisted trees) ---

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build outputs
node_modules
dist
dist-ssr
*.local
.env*
.DS_Store
.eslintcache
*.tsbuildinfo
coverage
.vite
*.asar

# Root / packaging outputs (also blocked by Layer 1; kept for nested paths)
/build/*
!/build/icons
/release
/out
/public/monaco

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code / Codex / other local agent state
# (Root agent dirs are also blocked by Layer 1; nested copies stay denied.)
.claude/
.codex/
.zcode/
.omo/
.qoder
.workbuddy
.codebuddy
.serena/
.superpowers/
.worktrees/

# AI / Superpowers generated docs (local only)
/docs/superpowers/


# Test suite (local only, not committed)
/tests/
/vitest.config.ts

# Windows VS Build environment scripts (local dev only)
Directory.Build.props
Directory.Build.targets
build_with_vs.bat
build_with_vs2022.bat

# Mosh helpers are fetched from the locked Wails helper supply; binaries are never committed.
/resources/mosh/*/mosh-client
/resources/mosh/*/mosh-client.exe

# EternalTerminal helpers are fetched from the locked Wails helper supply; binaries are never committed.
/resources/et/*/et
/resources/et/*/et.exe
/resources/et/*/et-*-dlls/
/resources/et/*/*.dll
